+
+                        Texture newTextureAsset = new Texture(textureAsset.Type, pixelFormat, (ushort)header.dwWidth, (ushort)header.dwHeight, depth) { FirstMip = textureAsset.FirstMip };
+                        if (header.dwMipMapCount <= textureAsset.FirstMip)
