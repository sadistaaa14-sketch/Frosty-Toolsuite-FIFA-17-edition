<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <Configurations>Developer - Debug;Release - Alpha;Release - Beta;Release - Final</Configurations>
    <Platforms>x64</Platforms>
    <TargetFrameworks>net48</TargetFrameworks>
    <AssemblyTitle>SoundEditorPlugin</AssemblyTitle>
    <Product>SoundEditorPlugin</Product>
    <Copyright>Copyright ©  2020</Copyright>
    <CodeAnalysisRuleSet>MinimumRecommendedRules.ruleset</CodeAnalysisRuleSet>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <UseWPF>true</UseWPF>
    <OutputType>Library</OutputType>
  </PropertyGroup>
  
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Developer - Debug|x64'">
    <DebugSymbols>true</DebugSymbols>
    <OutputPath>bin\Developer\Debug\</OutputPath>
    <DefineConstants>TRACE;DEBUG;FROSTY_DEVELOPER</DefineConstants>
  </PropertyGroup>
  
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release - Alpha|x64'">
    <OutputPath>bin\Release\Alpha\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
  </PropertyGroup>
  
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release - Beta|x64'">
    <OutputPath>bin\Release\Beta\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
  </PropertyGroup>
  
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release - Final|x64'">
    <OutputPath>bin\Release\Final\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
  </PropertyGroup>
  
  <!--
    Copies the built plugin into the editor's deployment, where the editor loads it from. `xcopy` cannot be used
    with a destination that ends in a backslash immediately before the closing quote: the backslash escapes the
    quote, xcopy reports "Invalid number of parameters" and exits 4, and the editor goes on loading whatever
    plugin it was built with. Naming the destination *file* has no such parsing trap, and the copy says so when it
    fails (a running editor holds the DLL open, which is the one reason this can still refuse).
  -->
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="copy /Y &quot;$(TargetPath)&quot; &quot;$(SolutionDir)$(OutDir)Plugins\SoundEditorPlugin.dll&quot;" />
  </Target>
  
  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="4.7.0" />
  </ItemGroup>
  
  <ItemGroup>
    <Reference Include="NAudio">
      <HintPath>..\..\FrostyEditor\ThirdParty\NAudio.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="NAudio.WaveFormRenderer">
      <HintPath>..\..\FrostyEditor\ThirdParty\NAudio.WaveFormRenderer.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="SharpDX">
      <HintPath>..\..\FrostyEditor\ThirdParty\SharpDX.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="SharpDX.XAudio2">
      <HintPath>..\..\FrostyEditor\ThirdParty\SharpDX.XAudio2.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\..\FrostyControls\FrostyControls.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\..\FrostyPlugin\FrostyCore.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\..\FrostySdk\FrostySdk.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>
  
  <ItemGroup>
    <Resource Include="Images\SoundFileType.png" />
  </ItemGroup>

  <!--
    Clip names derived from listening to the audio are not part of the plugin: every name it shows comes from the
    bank's own selection keys, the game's event-system names and the game's database. These three files held the
    listening-derived tables and their readers; they are excluded here so a checkout that still has them builds
    the same plugin, and they can be deleted.
  -->
  <ItemGroup>
    <Compile Remove="SoundRowCategories.cs" />
    <Compile Remove="FifaClipMap.cs" />
    <Compile Remove="FifaKeyTable.cs" />
  </ItemGroup>
</Project>