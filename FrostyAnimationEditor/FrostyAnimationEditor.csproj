<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <!-- FIFA 17 animation editor: Frosty Editor plugin (Tools > Animation Editor) for the AntStateAsset
       (fifagame_win32_antstate.res). Core\ is UI-independent; Frosty\ talks to Frosty; Windows\ is the editor UI. -->
  <PropertyGroup>
    <Configurations>Developer - Debug;Release - Alpha;Release - Beta;Release - Final</Configurations>
    <Platforms>x64</Platforms>
    <TargetFrameworks>net48</TargetFrameworks>
    <AssemblyTitle>FrostyAnimationEditor</AssemblyTitle>
    <Product>FrostyAnimationEditor</Product>
    <Copyright>Copyright ©  2026</Copyright>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <UseWPF>true</UseWPF>
    <OutputType>Library</OutputType>
    <RootNamespace>FrostyAnimationEditor</RootNamespace>
    <AssemblyName>FrostyAnimationEditor</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <NoWarn>CS0168;CS0219;CS0162;CS0675;CS1718</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Developer - Debug|x64' ">
    <DebugSymbols>true</DebugSymbols>
    <OutputPath>bin\Developer\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release - Alpha|x64' ">
    <OutputPath>bin\Release\Alpha\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release - Beta|x64'">
    <OutputPath>bin\Release\Beta\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release - Final|x64'">
    <OutputPath>bin\Release\Final\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.Xaml" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Numerics" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FrostyControls\FrostyControls.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\FrostyPlugin\FrostyCore.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\FrostySdk\FrostySdk.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\Plugins\MeshSetPlugin\MeshSetPlugin.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Core\Data\*.json" LogicalName="FrostyAnimationEditor.Data.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Core\Data\field_semantics.tsv;Core\Data\context_fields.tsv;Core\Data\context_interfaces.tsv" LogicalName="FrostyAnimationEditor.Data.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Resources\io_fifa17_antanim.py" LogicalName="FrostyAnimationEditor.Resources.io_fifa17_antanim.py" />
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="xcopy /Y &quot;$(TargetPath)&quot; &quot;$(SolutionDir)$(OutDir)Plugins\&quot;" />
  </Target>

</Project>
